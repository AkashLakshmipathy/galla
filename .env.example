# Copy to .env and fill in. Nothing secret belongs in here — real secrets go in
# Secret Manager and are mounted by Cloud Run.

GOOGLE_CLOUD_PROJECT=galla-hackathon
GOOGLE_CLOUD_LOCATION=asia-south1

# Pinned GA model ids, never a `-latest` alias. Google's docs say the aliases
# are hot-swapped with every release and are not recommended for production, and
# `gemini-flash-latest` was returning 503 under load while pinned models answered
# in about a second. A pinned id is also the only way a judge can confirm which
# model actually ran, and the hackathon requires Gemini 3.5+.
#
# Flash, not Pro: the work is extraction plus one sentence of phrasing, and the
# credits have to survive to demo day.
GEMINI_MODEL=gemini-3.5-flash

# Extraction-heavy agents (intake, purchase entry, khata) use Flash-Lite, which
# Google recommends for document parsing and which measured ~3x faster here.
GEMINI_MODEL_FAST=gemini-3.5-flash-lite

# A hung model call is worse than a failed one — the trace strip is on camera.
LLM_TIMEOUT_SECONDS=20
GOOGLE_GENAI_USE_VERTEXAI=true

GCS_BUCKET=galla-media
PUBSUB_TOPIC=shop-events
FIRESTORE_DATABASE=(default)

# Below this, an extracted value goes to the confirm queue instead of the books.
CONFIDENCE_THRESHOLD=0.85

# Shows the demo composer chip in the PWA. Turn off for a real shop.
DEMO_MODE=true

# firestore | local. Unset auto-detects: real Firestore when credentials are
# visible, otherwise a JSON store under backend/.localdata so the whole fleet
# runs with no GCP account at all.
# GALLA_STORE=local

# Local development only. Gitignored. Production secrets go in Secret Manager.
# GOOGLE_API_KEY=your-ai-studio-key

# --- Agent model provider (hard rule 10: one switch, no vendor named elsewhere) ---
# bedrock  Amazon Bedrock, Strands' native provider (needs AWS creds + model access)
# litellm  Gemini through LiteLLM (uses GOOGLE_API_KEY above)
# none     force the deterministic path — what the test suite runs on
# Unset, Galla takes the path it can verify: Gemini key, else AWS creds, else none.
GALLA_MODEL_PROVIDER=
BEDROCK_MODEL=global.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_FAST=us.amazon.nova-lite-v1:0
AWS_REGION=us-east-1
