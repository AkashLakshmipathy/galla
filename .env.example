# Copy to .env and fill in. Nothing secret belongs in here — real secrets go in
# Secret Manager and are mounted by Cloud Run.

GOOGLE_CLOUD_PROJECT=galla-hackathon
GOOGLE_CLOUD_LOCATION=asia-south1

# Pin to the current Gemini 3.5+ flash model at build time. Flash, not Pro:
# the work is extraction and one sentence of phrasing, and the credits have to
# survive to demo day.
GEMINI_MODEL=gemini-flash-latest
GOOGLE_GENAI_USE_VERTEXAI=true

GCS_BUCKET=galla-media
PUBSUB_TOPIC=shop-events
FIRESTORE_DATABASE=(default)

# Below this, an extracted value goes to the confirm queue instead of the books.
CONFIDENCE_THRESHOLD=0.85

# Shows the demo composer chip in the PWA. Turn off for a real shop.
DEMO_MODE=true

# firestore | local. Unset auto-detects: real Firestore when credentials are
# visible, otherwise a JSON store under backend/.localdata so the whole fleet
# runs with no GCP account at all.
# GALLA_STORE=local
